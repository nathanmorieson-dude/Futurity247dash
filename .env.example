# Copy to .env.local and fill in. Nothing here is required for the mock/demo
# dashboard — it only flips on real integrations when the values are present.

# ── Retell AI ──────────────────────────────────────────────────────────────
# Secret key from https://app.retellai.com → API keys. Required for live mode.
RETELL_API_KEY=

# Shared secret configured in Retell when you register the webhook URL. When
# set, every inbound call from Retell (function calls + call_ended webhook)
# must include a valid x-retell-signature header.
RETELL_WEBHOOK_SECRET=

# Agent ID of the deployed Billie agent for this client. Required for both
# /api/admin/retell/sync-agent and the "Talk to Billie" web-call demo.
RETELL_AGENT_ID=

# Flip to "1" to disable mock responses and actually hit Google Calendar /
# Supabase / Twilio from the function-call handlers. Defaults to "0".
RETELL_LIVE=0

# Public URL where Retell should send function calls + webhooks. Used when
# syncing the agent config so tool URLs point at the right deployment.
APP_URL=http://localhost:3000

# ── Admin panel ────────────────────────────────────────────────────────────
# Password required to sign in at /admin/login. The panel is hidden until
# this is set (no anonymous access). Generate something long and random.
ADMIN_PASSWORD=

# Optional. HMAC secret used to sign the admin session cookie. Falls back to
# ADMIN_PASSWORD if unset, but you should set this to a separate 32+ char
# random string in production so rotating the password doesn't invalidate
# in-flight sessions when you don't mean to.
ADMIN_COOKIE_SECRET=
